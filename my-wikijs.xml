  <Config Name="Uploads" Target="/wiki/data/uploads" Default="/mnt/user/appdata/wikijs/uploads" Mode="rw" Description="Uploaded files (images, attachments)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/wikijs/uploads</Config>
