  <Description>Wiki.js 2.x wiki engine on Tower04 dockernet (10.47.40.52), backed by wikijs-db PostgreSQL.</Description>
  <Config Name="DB_TYPE" Target="DB_TYPE" Default="postgres" Mode="" Description="Database type" Type="Variable" Display="advanced" Required="true" Mask="false">postgres</Config>
  <Config Name="DB_HOST" Target="DB_HOST" Default="10.47.40.51" Mode="" Description="PostgreSQL host (wikijs-db container IP on dockernet)" Type="Variable" Display="always" Required="true" Mask="false">10.47.40.51</Config>
  <Config Name="DB_PORT" Target="DB_PORT" Default="5432" Mode="" Description="PostgreSQL port" Type="Variable" Display="advanced" Required="true" Mask="false">5432</Config>
  <Config Name="DB_NAME" Target="DB_NAME" Default="wikijs" Mode="" Description="Database name (must match wikijs-db POSTGRES_DB)" Type="Variable" Display="always" Required="true" Mask="false">wikijs</Config>
  <Config Name="DB_USER" Target="DB_USER" Default="wikijs" Mode="" Description="Database user (must match wikijs-db POSTGRES_USER)" Type="Variable" Display="always" Required="true" Mask="false">wikijs</Config>
  <Config Name="DB_PASS" Target="DB_PASS" Default="" Mode="" Description="Database password (must match wikijs-db POSTGRES_PASSWORD)" Type="Variable" Display="always" Required="true" Mask="true"></Config>
